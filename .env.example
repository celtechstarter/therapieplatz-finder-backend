# Vorlage fuer die echte .env im Projekt-Root.
#
# Kopieren und ausfuellen:
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# Die echte .env steht in .gitignore und darf NIEMALS committet werden.
# Hier stehen ausschliesslich Platzhalter, keine echten Werte.
# Geladen wird die Datei von backend/analyzer.py und backend/main.py
# (python-dotenv, load_dotenv()).

# PFLICHT: API-Schluessel fuer die Claude-API (KI-Analyse der Profile).
# Zu finden unter https://console.anthropic.com/ -> API Keys.
# Ohne diesen Schluessel bricht main.py sofort ab, bevor der Scraper startet
# (siehe main._pruefe_api_key) -- der Analyzer koennte sonst erst nach
# stundenlangem Scrapen scheitern.
ANTHROPIC_API_KEY=

# OPTIONAL: Modell fuer die Analyse (backend/analyzer.py, Variable MODEL).
# Leer lassen oder Zeile weglassen -> Standardwert "claude-sonnet-4-5".
# Nur setzen, wenn bewusst ein anderes Modell genutzt werden soll.
CLAUDE_MODEL=

# OPTIONAL: nur fuer backend/umkreis_ausbau.py (Einzugsgebiet erweitern).
# Zu finden unter https://www.firecrawl.dev/app -> API Keys.
FIRECRAWL_API_KEY=
# Credits pro Monat (Free-Plan: 1000). Das Skript hoert vorher auf.
FIRECRAWL_MONATSLIMIT=1000
# Sekunden Pause zwischen zwei Abrufen (Free-Plan erlaubt 10 pro Minute).
FIRECRAWL_PAUSE=6.5

# Optional: Name/Situationssatz fuer das lokale Referenzfeld Email_generiert in
# results_analyzed.json (wird von der Webapp nicht verwendet). Ohne Angabe
# stehen neutrale Platzhalter drin. Keine echten Gesundheitsdaten committen.
# REFERENZ_NAME=Max Mustermann
# REFERENZ_SITUATION=Ich suche einen ambulanten Psychotherapieplatz.
